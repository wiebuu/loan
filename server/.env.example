# Postgres connection. On a Mac with Postgres.app or Homebrew the default user is your Mac username, no password.
DATABASE_URL=postgres://localhost:5432/loan

PORT=4000

# Dates ("today", overdue) are worked out in this time zone.
APP_TIMEZONE=Asia/Kolkata

# Demo only: also send the OTP back in the API response so the app can fill it in by itself.
# The OTP is always printed in the server log. Set to false for a real deployment.
OTP_IN_RESPONSE=true

# How long a lender has to wait between reminders for the same loan.
REMINDER_COOLDOWN_MINUTES=60
